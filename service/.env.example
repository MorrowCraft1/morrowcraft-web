# Copy this file to ".env" and fill it in. NEVER commit ".env" or share it.
# Everything else (group names, channel IDs, stat keys) is read from ../site.config.js

# ---- How often to refresh, in minutes (minimum 5) ----
INTERVAL_MINUTES=15

# ---- Database (LuckPerms and zLeaderboard) ----
# BloomHost gives each database its own login. Copy host, name, username and password
# from the panel's "Database connection details" for each one. The host has no ":3306".
DB_HOST=fsn-261018.bloom.host
DB_PORT=3306

ZLB_DB_NAME=
ZLB_DB_USER=
ZLB_DB_PASS=
ZLB_TABLE=zleaderboard_stats

LP_DB_NAME=
LP_DB_USER=
LP_DB_PASS=
LP_TABLE_PREFIX=luckperms_

# ---- Discord bot (the bot you already have) ----
# Needs: View Channel + Read Message History on the news/updates/events channels,
# and the "Message Content Intent" switched on in the Discord developer portal.
DISCORD_BOT_TOKEN=

# ---- Optional: short AI summaries of long Discord messages ----
# Leave empty to turn off. Uses the Claude API; one small call per new long message.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# ---- Where the JSON files go ----
# github = commit the files to your repo; Cloudflare Pages redeploys the site when they change (recommended)
# files  = write them into ../data (only if the service runs next to the website files)
PUBLISH_MODE=github

# Only for PUBLISH_MODE=github
GITHUB_REPO=MorrowCraft1/morrowcraft-web
GITHUB_BRANCH=main
GITHUB_TOKEN=
